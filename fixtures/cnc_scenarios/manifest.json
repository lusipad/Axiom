{
  "suiteId": "axiom.cnc-synthetic-scenarios@1",
  "datasetType": "deterministic-engineering-synthetic",
  "synthetic": true,
  "disclaimer": "These fixtures model sampled CNC-like geometry and timing. They are not real machine observations and do not establish controller, process, collision, or safety claims.",
